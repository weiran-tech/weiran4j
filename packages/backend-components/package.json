{
  "name": "@weiran-tech/backend-components",
  "version": "0.1.0",
  "description": "Reusable React components for Weiran admin applications",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiran-tech/weiran4j.git",
    "directory": "packages/backend-components"
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run --json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@douyinfe/semi-ui": "^2.104.0",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@douyinfe/semi-ui": "^2.104.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "lucide-react": "^1.61.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
