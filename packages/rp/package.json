{
  "name": "@weiran/rp",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs",
    "build": "pnpm version:check && pnpm build:web",
    "build:site": "pnpm build && node scripts/build-version.mjs && node scripts/assemble-site.mjs",
    "build:web": "tsc -b && vue-tsc --noEmit -p tsconfig.mobile.json && vite build",
    "test": "pnpm version:check && pnpm test:tooling && vitest run",
    "lint": "pnpm version:check && eslint src && vue-tsc --noEmit -p tsconfig.mobile.json",
    "version:work": "node scripts/version-work.mjs",
    "version:new": "node scripts/new-version.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "test:tooling": "node --test scripts/*.test.mjs prototype/*.test.mjs",
    "build:deploy": "node scripts/deploy-build.mjs",
    "check:site": "node scripts/smoke-site.mjs",
    "candidate": "node scripts/snapshot.mjs --candidate",
    "version:import": "node scripts/import-version.mjs",
    "test:watch": "vitest",
    "lint:fix": "eslint src --fix",
    "preview": "vite preview --port 5208 --strictPort",
    "check:versions": "pnpm version:check"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-custom-media": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  },
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@douyinfe/semi-ui": "^2.104.0",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@weiran-tech/manage": "^0.5.0",
    "dayjs": "^1.11.21",
    "html2canvas-pro": "^2.6.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1",
    "vant": "^4.9.0",
    "vue": "^3.5.0",
    "@weiran-tech/prototype": "^0.1.0"
  }
}
