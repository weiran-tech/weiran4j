# 本地开发配置样例。复制为 config/application-local.yml 后填真实值：
#
#   cp config/application-local.yml.example config/application-local.yml
#
# config/application-local.yml 已在 .gitignore 中，且位于源码树之外——它不会进版本库，
# 也不会被打进 jar。
#
# ⚠️ 密钥只能写在这里，绝不能写进 weiran-app/src/main/resources/application.yml，
#    那个文件会随 bootJar 一起分发（宪法 CP-9）。

spring:
  datasource:
    # 迁移期两套系统并行读写同一套 pam_* 表，本地可直接连 PHP 侧的库（weiran_v1）。
    # 连之前必须先执行 docs/20-数据迁移注意事项.md 里的 password 列宽 ALTER，
    # 否则登录成功后的 BCrypt 重哈希会被 varchar(45) 静默截断。
    url: jdbc:mysql://127.0.0.1:3306/weiran?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: ""

weiran:
  system:
    jwt:
      # 至少 32 字节，否则 JwtAccessTokenIssuer 在启动时直接抛异常。
      # 生成方式：openssl rand -base64 48
      secret: ""

server:
  port: 3300

logging:
  level:
    com.weiran: DEBUG
