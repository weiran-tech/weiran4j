# weiran4j **部署环境**变量样例（容器 / systemd）。本地开发不用这个 ——
# 本地走 config/application-local.yml，见 config/application-local.yml.example。
#
# 保留这条路径的原因：application.yml 里的 ${WEIRAN_*:默认值} 占位符是部署契约。
# 环境变量的优先级高于 jar 内的 application.yml，所以部署时无需改任何文件即可覆盖。
#
# ⚠️ 任何密钥都不要写进 application.yml —— weiran-v1 的 README.md 里明文躺着
#    阿里云 AccessKey 与推送 SECRET，那批密钥建议轮换，且绝不迁移到本仓。

# 数据库
WEIRAN_DB_URL=jdbc:mysql://127.0.0.1:3306/weiran?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
WEIRAN_DB_USERNAME=root
WEIRAN_DB_PASSWORD=

# JWT 签名密钥，至少 32 字节。生成方式：openssl rand -base64 48
WEIRAN_JWT_SECRET=

# 服务端口与日志级别
WEIRAN_PORT=3300
WEIRAN_LOG_LEVEL=INFO
