{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".vitepress/dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "JAVA_HOME",
        "JAVA_HOME_21",
        "WEIRAN_*",
        "SERVER_PORT",
        "SPRING_*",
        "VITE_PROTOTYPE_*",
        "VITE_APP_TITLE"
      ]
    },
    "//#test:flows:unit": {
      "cache": false
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "@weiran/rp#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".prototype-data/web-build/**"
      ],
      "env": [
        "VITE_PROTOTYPE_BASE",
        "VITE_PROTOTYPE_VERSION",
        "VITE_PROTOTYPE_ARCHIVE_ID",
        "VITE_PROTOTYPE_KIND",
        "VITE_PROTOTYPE_FINGERPRINT",
        "VITE_APP_TITLE"
      ]
    }
  }
}
